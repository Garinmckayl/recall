# Jev (TypeSafe Decisions API) + fallback LLMs via OpenRouter
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# AWS: Bedrock (Nova Pro/Lite, Titan) uses the standard credential chain (env, ~/.aws, role)
AWS_REGION=us-west-2

# Ring Partner API. Leave RING_ACCESS_TOKEN empty to use the local sandbox.
RING_ACCESS_TOKEN=
RING_HMAC_KEY=sandbox-hmac-key
SERVER_URL=http://127.0.0.1:8000

# Push notifications (topic is the secret) and optional MCP bearer token
NTFY_TOPIC=
MCP_TOKEN=
