# Copy to deploy/host.env (gitignored) and fill in for your own EC2 host.
export RECALL_HOST=203.0.113.10                 # public IP or DNS of an Ubuntu EC2 instance you can SSH into
export RECALL_KEY=$HOME/your-key.pem            # SSH key for that instance
export RECALL_INSTANCE_ID=i-0123456789abcdef0   # for the Bedrock instance role
export RECALL_SG_ID=sg-0123456789abcdef0        # security group to open tcp/8300 on
export RECALL_REGION=us-east-1
